# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored. Production values come from the deploy environment
# (ECS task definition / Parameter Store / etc., decided in Phase 2).

# JWT signing secret. Generate a strong value, e.g.:
#   openssl rand -base64 32
JWT_SECRET=

# 외부 식별자 난독화 salt(Hashids — 주문번호 등). salt 가 곧 키라 운영에선 강한 고정값, 바꾸면 기존 코드 decode 불가.
# 로컬은 비워두면 application.yml 기본값(pungdong-local-dev-salt) 사용. 운영은 반드시 고정 주입.
HASHIDS_SALT=

# Gmail (or SMTP) account used for sending verification emails.
# For Gmail with 2FA: create an App Password at
# https://myaccount.google.com/apppasswords and put it here (NOT your
# regular Google password).
ADMIN_MAIL_ID=
ADMIN_MAIL_PASSWORD=

# --- Firebase / FCM ---
# Set FIREBASE_ENABLED=true to route notifications through the real FCM API.
# Leave unset (default) and NotificationDeliveryWorker falls back to
# LoggingFcmGateway, which just logs the would-be notification and returns
# SUCCESS. This lets bootRun work without any Firebase setup for local dev.
FIREBASE_ENABLED=

# Two ways to authenticate to Firebase / GCP, in order of preference:
#
# (A) ADC — Application Default Credentials (recommended, keyless)
#     Run once: gcloud auth application-default login
#     Then leave FIREBASE_CREDENTIALS_PATH unset. Spring picks up ADC from
#     ~/.config/gcloud/application_default_credentials.json.
#     Production runtime (Phase 4) uses Workload Identity Federation between
#     the deploy environment (e.g. AWS IAM role) and a GCP service account
#     — same code path, no key files anywhere.
#
# (B) Service account key file (legacy)
#     If your org policy allows, generate a key in Firebase Console ->
#     Project settings -> Service accounts -> Generate new private key.
#     Save OUTSIDE this repo (e.g. ~/Documents/secrets/<file>.json),
#     reference here as an absolute path. .env.local is gitignored, but the
#     key file itself should also live outside the repo.
FIREBASE_CREDENTIALS_PATH=

# --- CORS ---
# Comma-separated origins allowed to call this API from a browser.
# Default (dev): http://localhost:3000,http://localhost:5173 — covers Next.js
# and Vite dev servers. Production must set this to the actual web origin(s),
# e.g. CORS_ALLOWED_ORIGINS=https://pungdong.com,https://www.pungdong.com
CORS_ALLOWED_ORIGINS=

# --- 강사 신청 / 어드민 (instructor-application) ---
# 어드민 지정 allowlist. 부팅 시 이 이메일 계정에 ROLE_ADMIN 부여(idempotent).
# 계정은 먼저 일반 가입돼 있어야 하고, 설정 후 재기동하면 승격됨. 비우면 어드민 없음.
# 여러 명이면 콤마구분, 공백 없이 (셸 source 라 공백 있으면 따옴표 필요):
#   ADMIN_EMAILS=me@plop.cool,ops@plop.cool
ADMIN_EMAILS=

# 자격증 이미지 저장소. 비워두면(false) dev = 로컬 디스크(./local-uploads)에 저장 +
# /local-uploads/** 로 서빙. prod(S3 버킷 provision 후)만 true 로.
STORAGE_S3_ENABLED=
# (선택) 로컬 저장 경로 / 서빙 base URL — 기본값 local-uploads / http://localhost:8080.
# FE 가 다른 호스트면 base URL 을 실제 접근 가능한 주소로.
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_BASE_URL=
# 공개 이미지(코스/프로필/리뷰) 전용 — prod/staging 에서 Terraform 이 주입(로컬은 비워둠 → 메인
# 버킷 + S3 URL 폴백, dev 는 어차피 로컬 디스크). 공개 버킷 + CDN 도메인은 docs/features/image-storage-and-serving.md.
#   CLOUD_AWS_S3_PUBLIC_BUCKET=plop-staging-public
#   STORAGE_PUBLIC_BASE_URL=https://cdn-staging.plop.cool
CLOUD_AWS_S3_PUBLIC_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# 본인확인(휴대폰 SMS, 포트원 REST v2 / 다날) 모드: stub | disabled | real.
# dev 기본 stub(문자 미발송, 매직 OTP "000000"=성공). prod 는 다날 CPID 개통 전까지 disabled(fail-closed),
# 개통 후 real 로 전환 + 아래 PORTONE_*/IDENTITY_CRYPTO_KEY 설정.
IDENTITY_VERIFICATION_MODE=
# CI/DI(고유식별정보) 암호화 키 — 어떤 문자열이든 SHA-256 으로 AES-256 키 유도. prod 필수(미설정 시 dev 폴백 + WARN).
IDENTITY_CRYPTO_KEY=
# 포트원 본인확인 채널 (다날 CPID 매핑). 전부 BE 전용 시크릿 — 밖으로 절대 노출 금지.
# CPID 개통(통신사 심사, 리드타임 최대 1주) 후 포트원 콘솔에서 발급.
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=

# --- 약관 콘텐츠 (Sanity, consent 도메인) ---
# 동의 기록 시 BE 가 (key,version) 으로 약관 전문을 Sanity 에서 직접 받아 박제한다.
# public dataset 읽기라 토큰 불필요. projectId 는 공개값(FE 와 동일) — 기본 rc448mwo 면 비워도 됨.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
# legal 프록시(GET /legal/{slug})만 read 토큰 필요 — legalDocument 가 익명 거부라(legal/CLAUDE.md).
# Viewer read-only 토큰. 비우면 로컬에서 법적 고지 페이지가 빈 응답(404). manage.sanity.io → API → Tokens.
SANITY_TOKEN=

# --- 주소 검색 + 좌표 변환 (juso, address 도메인) ---
# 좌표제공 API 는 개발용 승인키가 없어 로컬은 stub 기본(고정 좌표). 실호출은 staging/prod 에서만.
# ADDRESS_GEOCODE_MODE=juso 로 전환 시 키 2개(검색/좌표) + 등록 URL(referer) 필요.
ADDRESS_GEOCODE_MODE=
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=
JUSO_REFERER=

# --- 결제 (payment 도메인) ---
# PAYMENT_MODE = stub | toss | kcp | inicis — 부팅 시 게이트웨이 하나만 활성(런타임 주문별 라우팅 없음).
# 로컬 기본 stub(외부 PG 미호출, 승인 즉시 성공) — 개발이 외부 PG 에 묶이지 않게. 실연동은 staging/prod 에서만.
PAYMENT_MODE=

# (toss) 토스페이먼츠 결제위젯 v2. 키 발급 전에는 토스 "문서용 테스트 키" 사용 가능:
#   TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
#   TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 시크릿 키는 BE 밖으로 절대 노출 금지(승인 Basic 인증용). 클라이언트 키만 FE 위젯에 내려간다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# (inicis) KG이니시스 INIpay PRO 표준결제 — 간편결제가 카드 결제창에 노출(P_PAY_TYPE=CARD)로 카드+간편결제.
# 테스트/운영은 엔드포인트가 아니라 MID 로 갈린다(테스트 INIpayTest) — live 플래그 없음.
# INICIS_HASH_KEY = P_CHKFAKE 서명용 HMAC 해시키, INICIS_API_KEY = 환불(INIAPI) hashData 용 키 (둘 다 노출 금지).
# INICIS_RET_URL = 결제창이 인증결과(P_AUTH_TID 등)를 form POST 할 BE 콜백 — 예: https://api-staging.plop.cool/payments/inicis/return
# 리다이렉트 타겟은 주문의 client(web/app)로 아래 고정 allowlist 중 하나 선택(오픈 리다이렉트 방지).
# INICIS_CLIENT_IP = 환불 전문의 가맹점 서버 IP — 이니시스가 등록 IP와 대조하면 고정 egress(fck-nat) 필요.
INICIS_MID=
INICIS_HASH_KEY=
INICIS_API_KEY=
INICIS_CLIENT_IP=
INICIS_RET_URL=
INICIS_RETURN_WEB_SUCCESS=
INICIS_RETURN_WEB_FAIL=
INICIS_RETURN_APP_SUCCESS=
INICIS_RETURN_APP_FAIL=

# --- 데모/시드 토글 ---
# (유지) 시드 강의(seeded) 강사에게 가용시간 전체 개방 → 시드 강의가 신청 가능해짐. 한 번 켜서 부팅하면
#        coverage 가 DB 에 남음(멱등). 테스트 강의는 제외(seeded 강사만).
DEMO_SEED_AVAILABILITY=
# (자동수락 DEMO_AUTO_ACCEPT / DemoAutoAcceptScheduler 는 선결제 전환으로 제거됨 — 결제가 강사 수락 앞으로
#  와서 심사자가 자동수락 없이도 결제까지 도달한다.)

# --- 닉네임 사전 점검 (일회성 진단, 기본 OFF) ---
# true 로 켜면 부팅 시 읽기 전용 조회 결과를 로그로 1회 남긴다 — account.nick_name 에 UNIQUE 인덱스를
# 걸기 전에 중복·예약어·URL불가(/ 또는 \) 계정이 실제로 몇 건인지 확인하는 용도.
# dedupe 는 유저에게 보이는 식별자를 바꾸는 동작이라, 이 숫자를 승인받은 뒤에만 실행한다.
# 확인이 끝나면 이 변수와 account/audit 패키지를 함께 제거한다.
AUDIT_NICKNAME_ENABLED=
